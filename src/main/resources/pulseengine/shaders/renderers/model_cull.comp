#version 430 core

layout(local_size_x = 64) in;

struct InstanceData
{
    mat4 model;
    vec4 params;
};

struct MeshMetadata
{
    uvec4 draw;
    vec4 centerXHalf;    // xyz=center, w=xHalf
    vec4 yzHalfReserved; // xy=yzHalf, z/w=reserved
    uvec4 skinning;      // x=boundsOffset, y=boundsCount, z=includeBaseBoundsInSkinning, w=reserved
};

struct CullItem
{
    uint meshMetadataIndex;
    uint instanceIndex;
    uint dynamicBoundsIndex;
    uint flags;
};

struct DynamicBounds
{
    vec4 centerXHalf;   // xyz=center, w=xHalf
    vec4 yzHalfReserved;// xy=yzHalf, z/w=reserved
};

struct IndirectCommand
{
    uint count;
    uint instanceCount;
    uint firstIndex;
    uint baseVertex;
    uint baseInstance;
};

layout(std430, binding = 1) readonly buffer InstanceBuffer
{
    InstanceData uInstances[];
};

layout(std430, binding = 3) readonly buffer BoneBuffer
{
    mat4 uBoneMatrices[];
};

layout(std430, binding = 4) writeonly buffer VisibleInstanceBuffer
{
    uint uVisibleInstanceIndices[];
};

layout(std430, binding = 5) readonly buffer CullItemBuffer
{
    CullItem uCullItems[];
};

layout(std430, binding = 6) buffer CommandBuffer
{
    IndirectCommand uCommands[];
};

layout(std430, binding = 7) readonly buffer MeshMetaBuffer
{
    MeshMetadata uMeshMetadata[];
};

layout(std430, binding = 8) readonly buffer DynamicBoundsBuffer
{
    DynamicBounds uDynamicBounds[];
};

layout(std430, binding = 10) readonly buffer CullItemBatchIndexBuffer
{
    int uCullItemBatchIndices[];
};

layout(std430, binding = 12) readonly buffer SkinningBoundsBuffer
{
    uint uSkinningBounds[];
};

uniform vec4 uFrustumPlanes[96];
uniform int uFrustumPlaneCounts[4];
uniform int uInstanceCount;
uniform int uBatchCount;
uniform int uFrustumCount;
uniform int uCommandBaseIndex;
uniform int uCullItemBatchIndexOffset;

const uint STATIC_BOUNDS_INDEX = 0xFFFFFFFFu;
const uint CULL_FLAG_ALWAYS_VISIBLE = 1u;
const int MAX_PLANES_PER_FRUSTUM = 24;

bool intersectsFrustum(vec3 worldCenter, vec3 worldHalfExtents, int frustumIndex)
{
    int planeOffset = frustumIndex * MAX_PLANES_PER_FRUSTUM;
    int planeCount = uFrustumPlaneCounts[frustumIndex];
    for (int i = 0; i < planeCount; i++)
    {
        vec4 plane = uFrustumPlanes[planeOffset + i];
        float radius = dot(worldHalfExtents, abs(plane.xyz));
        float distance = dot(plane.xyz, worldCenter) + plane.w;
        if (distance < -radius)
            return false;
    }
    return true;
}

vec3 transformHalfExtents(mat4 transform, vec3 halfExtents)
{
    mat3 basis = mat3(transform);
    return vec3(
        dot(abs(vec3(basis[0].x, basis[1].x, basis[2].x)), halfExtents),
        dot(abs(vec3(basis[0].y, basis[1].y, basis[2].y)), halfExtents),
        dot(abs(vec3(basis[0].z, basis[1].z, basis[2].z)), halfExtents)
    );
}

void includeBounds(vec3 boundsMin, vec3 boundsMax, inout vec3 outMin, inout vec3 outMax, inout bool hasBounds)
{
    if (!hasBounds)
    {
        outMin = boundsMin;
        outMax = boundsMax;
        hasBounds = true;
        return;
    }

    outMin = min(outMin, boundsMin);
    outMax = max(outMax, boundsMax);
}

void includeTransformedAabb(mat4 transform, vec3 localMin, vec3 localMax, inout vec3 outMin, inout vec3 outMax, inout bool hasBounds)
{
    vec3 localCenter = (localMin + localMax) * 0.5;
    vec3 localHalfExtents = (localMax - localMin) * 0.5;
    vec3 transformedCenter = (transform * vec4(localCenter, 1.0)).xyz;
    vec3 transformedHalfExtents = transformHalfExtents(transform, localHalfExtents);

    includeBounds(transformedCenter - transformedHalfExtents, transformedCenter + transformedHalfExtents, outMin, outMax, hasBounds);
}

float skinningBoundsFloat(uint recordBase, uint component)
{
    return uintBitsToFloat(uSkinningBounds[recordBase + component]);
}

bool getSkinnedBounds(MeshMetadata meta, int boneOffset, inout vec3 localCenter, inout vec3 localHalfExtents)
{
    uint skinningBoundsOffset = meta.skinning.x;
    uint skinningBoundsCount = meta.skinning.y;
    if (boneOffset < 0 || skinningBoundsOffset == STATIC_BOUNDS_INDEX || skinningBoundsCount == 0u)
        return false;

    vec3 boundsMin = vec3(0.0);
    vec3 boundsMax = vec3(0.0);
    bool hasBounds = false;

    // Include base bounds in skinning bounds
    if (meta.skinning.z != 0u)
        includeBounds(localCenter - localHalfExtents, localCenter + localHalfExtents, boundsMin, boundsMax, hasBounds);

    for (uint i = 0u; i < skinningBoundsCount; i++)
    {
        uint recordBase = (skinningBoundsOffset + i) * 8u;
        uint boneIndex = uSkinningBounds[recordBase + 6u];

        mat4 boneMatrix = uBoneMatrices[boneOffset + int(boneIndex)];
        vec3 localMin = vec3(
            skinningBoundsFloat(recordBase, 0u),
            skinningBoundsFloat(recordBase, 1u),
            skinningBoundsFloat(recordBase, 2u)
        );
        vec3 localMax = vec3(
            skinningBoundsFloat(recordBase, 3u),
            skinningBoundsFloat(recordBase, 4u),
            skinningBoundsFloat(recordBase, 5u)
        );

        includeTransformedAabb(boneMatrix, localMin, localMax, boundsMin, boundsMax, hasBounds);
    }

    if (hasBounds)
    {
        localCenter = (boundsMin + boundsMax) * 0.5;
        localHalfExtents = (boundsMax - boundsMin) * 0.5;
    }
 
    return hasBounds;
}

void appendVisibleInstance(CullItem item, uint batchIndex, int frustum)
{
    uint commandIndex = uint(uCommandBaseIndex) + uint(frustum) * uint(uBatchCount) + batchIndex;
    uint visibleOffset = atomicAdd(uCommands[commandIndex].instanceCount, 1u);
    uint visibleIndex = uCommands[commandIndex].baseInstance + visibleOffset;
    uVisibleInstanceIndices[visibleIndex] = item.instanceIndex;
}

void main()
{
    uint itemIndex = gl_GlobalInvocationID.x;
    if (itemIndex >= uint(uInstanceCount))
        return;

    CullItem item = uCullItems[itemIndex];
    int batchIndex = uCullItemBatchIndices[uCullItemBatchIndexOffset + int(itemIndex)];
    if (batchIndex < 0)
        return;

    InstanceData instance = uInstances[item.instanceIndex];

    if ((item.flags & CULL_FLAG_ALWAYS_VISIBLE) != 0u)
    {
        for (int frustum = 0; frustum < uFrustumCount; frustum++)
            appendVisibleInstance(item, uint(batchIndex), frustum);
        return;
    }

    vec3 localCenter;
    vec3 localHalfExtents;

    if (item.dynamicBoundsIndex != STATIC_BOUNDS_INDEX)
    {
        DynamicBounds bounds = uDynamicBounds[item.dynamicBoundsIndex];
        localCenter = bounds.centerXHalf.xyz;
        localHalfExtents = vec3(bounds.centerXHalf.w, bounds.yzHalfReserved.x, bounds.yzHalfReserved.y);
    }
    else
    {
        MeshMetadata metadata = uMeshMetadata[item.meshMetadataIndex];
        localCenter = metadata.centerXHalf.xyz;
        localHalfExtents = vec3(metadata.centerXHalf.w, metadata.yzHalfReserved.x, metadata.yzHalfReserved.y);
        getSkinnedBounds(metadata, int(instance.params.y), localCenter, localHalfExtents);
    }

    vec3 worldCenter = (instance.model * vec4(localCenter, 1.0)).xyz;
    vec3 worldHalfExtents = transformHalfExtents(instance.model, localHalfExtents);

    for (int frustum = 0; frustum < uFrustumCount; frustum++)
    {
        if (!intersectsFrustum(worldCenter, worldHalfExtents, frustum))
            continue;

        appendVisibleInstance(item, uint(batchIndex), frustum);
    }
}